#!/usr/bin/env bash
#MISE description="Run backend plugin tests - exercise the cabal backend end-to-end"
set -euo pipefail

# Link this plugin under the name "cabal" for testing.
mise plugin link --force cabal .

# Clear cache so we exercise the real hooks.
mise cache clear

# `hello` is a tiny Hackage package: depends only on `base`, builds in seconds,
# and installs a `hello` executable that prints a greeting.
TEST_TOOL="hello"

echo "==> Listing versions for cabal:${TEST_TOOL} (BackendListVersions)"
mise ls-remote "cabal:${TEST_TOOL}"

if command -v ghc >/dev/null 2>&1 && command -v cabal >/dev/null 2>&1; then
    echo "==> Installing cabal:${TEST_TOOL}@latest (BackendInstall, compiles from source)"
    mise install "cabal:${TEST_TOOL}@latest"

    echo "==> Executing the installed binary (BackendExecEnv)"
    # `hello` has no --version flag, so run it bare and assert on its output.
    out="$(mise x "cabal:${TEST_TOOL}@latest" -- hello)"
    echo "    output: ${out}"
    case "${out}" in
    *Hello*) echo "OK: got expected greeting" ;;
    *)
        echo "FAIL: unexpected output from hello"
        exit 1
        ;;
    esac

    # Data-file tool check. pandoc reads its templates (data files) via getDataDir at
    # runtime, so a successful --print-default-template proves the per-tool CABAL_DIR
    # store, where those data files live, is correctly pointed to. Building pandoc from
    # source is heavy, so this runs on Linux only; the data-dir mechanism is identical
    # on every OS (the per-OS path handling is already covered by the hello install).
    if [ "$(uname -s)" = "Linux" ]; then
        echo "==> Installing cabal:pandoc-cli@latest (data-file tool; builds pandoc, slow)"
        mise install "cabal:pandoc-cli@latest"

        echo "==> Verifying pandoc resolves its data dir (--print-default-template)"
        tmpl="$(mise x "cabal:pandoc-cli@latest" -- pandoc --print-default-template=html)" || true
        case "${tmpl}" in
        *'$body$'*) echo "OK: pandoc read its default template, data dir resolved" ;;
        *)
            echo "FAIL: pandoc could not read its data files (data dir not pointed correctly)"
            exit 1
            ;;
        esac
    fi

    echo "All cabal backend tests passed."
else
    echo "skipping build test: ghc/cabal not on PATH"
fi
