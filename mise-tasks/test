#!/usr/bin/env bash
#MISE description="Run backend plugin tests - exercise the mise-cabal backend end-to-end"
set -euo pipefail

# Link this plugin under the name "mise-cabal" for testing.
mise plugin link --force mise-cabal .

# Clear cache so we exercise the real hooks.
mise cache clear

# `hello` is a tiny Hackage package: depends only on `base`, builds in seconds,
# and installs a `hello` executable that prints a greeting.
TEST_TOOL="hello"

echo "==> Listing versions for mise-cabal:${TEST_TOOL} (BackendListVersions)"
mise ls-remote "mise-cabal:${TEST_TOOL}"

if command -v ghc >/dev/null 2>&1 && command -v cabal >/dev/null 2>&1; then
    echo "==> Installing mise-cabal:${TEST_TOOL}@latest (BackendInstall, compiles from source)"
    mise install "mise-cabal:${TEST_TOOL}@latest"

    echo "==> Executing the installed binary (BackendExecEnv)"
    # `hello` has no --version flag, so run it bare and assert on its output.
    out="$(mise x "mise-cabal:${TEST_TOOL}@latest" -- hello)"
    echo "    output: ${out}"
    case "${out}" in
    *Hello*) echo "OK: got expected greeting" ;;
    *)
        echo "FAIL: unexpected output from hello"
        exit 1
        ;;
    esac

    # Data-file tool check. alex (the Haskell lexer generator) reads its code-gen
    # templates (AlexTemplate.hs / AlexWrappers.hs, declared as cabal data-files)
    # from its data dir at runtime via Paths_alex/getDataDir, so generating a lexer
    # proves the per-tool CABAL_DIR store, where those data files live, is pointed
    # to correctly. alex depends only on base/array/containers/directory, so unlike
    # pandoc it builds in seconds on every OS.
    echo "==> Installing mise-cabal:alex@latest (data-file tool, builds fast)"
    mise install "mise-cabal:alex@latest"

    echo "==> Verifying alex resolves its data dir (generates a lexer from its template)"
    work="$(mktemp -d)"
    cat >"${work}/lexer.x" <<'EOF'
{
module Main (main) where
}
%wrapper "basic"
tokens :-
  $white+      ;
  [a-zA-Z]+    { \s -> s }
{
main :: IO ()
main = return ()
}
EOF
    # Run from the temp dir with RELATIVE paths so this also works under Windows
    # Git Bash: the native alex.exe would not understand an MSYS "/tmp/..." path.
    ( cd "${work}" && mise x "mise-cabal:alex@latest" -- alex lexer.x -o lexer.hs )
    if grep -q 'alexScan' "${work}/lexer.hs"; then
        echo "OK: alex spliced in its template, data dir resolved"
    else
        echo "FAIL: alex could not read its template data files (data dir not pointed correctly)"
        exit 1
    fi
    rm -rf "${work}"

    echo "All mise-cabal backend tests passed."
else
    echo "skipping build test: ghc/cabal not on PATH"
fi
