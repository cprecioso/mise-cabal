#!/usr/bin/env bash
#MISE description="Run backend plugin tests - exercise the cabal backend end-to-end"
set -euo pipefail

# Link this plugin under the name "cabal" for testing.
mise plugin link --force cabal .

# Clear cache so we exercise the real hooks.
mise cache clear

# `hello` is a tiny Hackage package: depends only on `base`, builds in seconds,
# and installs a `hello` executable that prints a greeting.
TEST_TOOL="hello"

echo "==> Listing versions for cabal:${TEST_TOOL} (BackendListVersions)"
mise ls-remote "cabal:${TEST_TOOL}"

if command -v ghc >/dev/null 2>&1 && command -v cabal >/dev/null 2>&1; then
    echo "==> Installing cabal:${TEST_TOOL}@latest (BackendInstall, compiles from source)"
    mise install "cabal:${TEST_TOOL}@latest"

    echo "==> Executing the installed binary (BackendExecEnv)"
    # `hello` has no --version flag, so run it bare and assert on its output.
    out="$(mise x "cabal:${TEST_TOOL}@latest" -- hello)"
    echo "    output: ${out}"
    case "${out}" in
    *Hello*) echo "OK: got expected greeting" ;;
    *)
        echo "FAIL: unexpected output from hello"
        exit 1
        ;;
    esac
    echo "All cabal backend tests passed."
else
    echo "skipping build test: ghc/cabal not on PATH"
fi
